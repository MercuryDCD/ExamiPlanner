{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExamPlanStudioSchedule",
  "description": "Normalized schema for academic exam sessions and call planning",
  "type": "object",
  "required": ["meta", "subjects"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "academicYear", "session"],
      "properties": {
        "title": { "type": "string" },
        "institution": { "type": "string" },
        "academicYear": { "type": "string" },
        "session": { "type": "string" },
        "icon": { "type": "string", "description": "Emoji o icono representativo de la sesión (ej. ❄️, ☀️, 🍂, 🎓, 🤖)" },
        "targetCredits": { "type": "number", "minimum": 0 },
        "creditUnit": { "type": "string", "default": "CFU" }
      },
      "additionalProperties": true
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "shortName": { "type": "string", "description": "Abreviatura o acrónimo conciso de la asignatura (ej. FAI, ML, SD, CALC)" },
          "code": { "type": "string" },
          "credits": { "type": "number", "minimum": 0 },
          "color": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["high", "medium", "low"] },
          "defaultWeight": { "type": "number", "minimum": 1, "maximum": 5 },
          "hasModules": { "type": "boolean", "description": "Indica si la asignatura se divide en módulos o es unitaria sin módulos" },
          "alreadyPassed": { "type": "boolean", "default": false },
          "evaluationMode": {
            "type": "string",
            "enum": ["standard", "written_and_oral", "written_and_lab"],
            "default": "standard",
            "description": "Modalidad de evaluación requerida (a nivel de asignatura unitaria o módulo)"
          },
          "oralBinding": {
            "type": "string",
            "enum": ["same_appello", "any_subsequent"],
            "default": "same_appello",
            "description": "Vinculación del examen oral con respecto al escrito"
          },
          "calls": {
            "type": "array",
            "description": "Llamamientos o convocatorias directas si la asignatura no tiene módulos",
            "items": {
              "type": "object",
              "required": ["id", "date"],
              "properties": {
                "id": { "type": "string" },
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
                "durationHours": { "type": "number", "minimum": 0.5 },
                "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "location": { "type": "string" },
                "notes": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["active", "inactive", "activo", "desactivado", "inactivo"]
                },
                "active": { "type": "boolean" },
                "selected": { "type": "boolean" },
                "type": {
                  "type": "string",
                  "enum": ["standard", "written", "oral", "lab", "escrito", "orale", "scritto", "laboratorio"],
                  "default": "standard"
                },
                "appelloIndex": { "type": "integer", "minimum": 1 },
                "moduleIds": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": true
            }
          },
          "modules": {
            "type": "array",
            "description": "Lista de módulos si la asignatura está dividida en subpartes",
            "items": {
              "type": "object",
              "required": ["id", "name", "calls"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "shortName": { "type": "string", "description": "Etiqueta breve del módulo (ej. M1, M2, M2+3)" },
                "credits": { "type": "number", "minimum": 0 },
                "difficulty": { "type": "string", "enum": ["high", "medium", "low"] },
                "defaultWeight": { "type": "number", "minimum": 1, "maximum": 5 },
                "alreadyPassed": { "type": "boolean", "default": false },
                "evaluationMode": {
                  "type": "string",
                  "enum": ["standard", "written_and_oral", "written_and_lab"],
                  "default": "standard",
                  "description": "Modalidad de evaluación requerida para superar el módulo"
                },
                "oralBinding": {
                  "type": "string",
                  "enum": ["same_appello", "any_subsequent"],
                  "default": "same_appello",
                  "description": "Vinculación del examen oral con respecto al escrito (mismo llamamiento o flexible)"
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "date"],
                    "properties": {
                      "id": { "type": "string" },
                      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                      "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
                      "durationHours": { "type": "number", "minimum": 0.5 },
                      "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                      "location": { "type": "string" },
                      "notes": { "type": "string" },
                      "status": {
                        "type": "string",
                        "enum": ["active", "inactive", "activo", "desactivado", "inactivo"],
                        "description": "Estado de selección del llamamiento en el plan (active/inactive o activo/desactivado)"
                      },
                      "active": {
                        "type": "boolean",
                        "description": "Indica si el llamamiento está seleccionado/activo en el plan"
                      },
                      "selected": {
                        "type": "boolean",
                        "description": "Alias booleano alternativo de selección"
                      },
                      "type": {
                        "type": "string",
                        "enum": ["standard", "written", "oral", "lab", "escrito", "orale", "scritto", "laboratorio"],
                        "default": "standard",
                        "description": "Tipo de prueba (escrito, oral, laboratorio o estándar)"
                      },
                      "appelloIndex": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Número de llamamiento (1º appello, 2º appello, etc.)"
                      },
                      "moduleIds": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "IDs de módulos que se evalúan conjuntamente en esta convocatoria"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "selectedCallIds"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "selectedCallIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "selectedCallIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lista de identificadores de convocatorias seleccionadas/activas en el plan"
    }
  },
  "additionalProperties": true
}
